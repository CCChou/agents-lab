# Runs compose.prod.yaml as a system service on the RHEL host (D-041).
# Install as root by copying, not linking: under SELinux systemd cannot read a unit in /root.
#   install -m 644 /root/agents-lab/deploy/agents-lab.service /etc/systemd/system/
#   restorecon /etc/systemd/system/agents-lab.service
#   systemctl daemon-reload && systemctl enable --now agents-lab
# The unit starts the container at boot and stops it on shutdown; restart: always in the compose
# file restarts it when it exits. Copy it again and daemon-reload after this file changes.
[Unit]
Description=agents-lab (podman compose)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/agents-lab
# AGENT_IMAGE_TAG=<commit sha>, written on each deploy; without the file compose uses latest.
EnvironmentFile=-/etc/agents-lab/image.env
ExecStart=/usr/bin/podman compose -f deploy/compose.prod.yaml up -d
ExecStop=/usr/bin/podman compose -f deploy/compose.prod.yaml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
