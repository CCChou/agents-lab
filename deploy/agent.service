# Runs the HTTP API (D-035). Copy to /etc/systemd/system/ and adjust the paths and user.
[Unit]
Description=agents-lab HTTP API
After=network-online.target
Wants=network-online.target

[Service]
User=agent
WorkingDirectory=/opt/agents-lab
# prod.env holds the secrets (D-038) and uses `export VAR=...`, which EnvironmentFile=
# may not accept, so source it in a shell.
ExecStart=/bin/bash -c 'source /opt/agents-lab/prod.env && exec /usr/local/bin/uv run python -m agent serve --config /opt/agents-lab/config.toml'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
